opam-version: "2.0"
synopsis: "OCaml SDN Controller for TradeNet Fabric"
description:
  "A software-defined networking controller that ingests real-time telemetry, computes optimal paths using Dijkstra's algorithm weighted by live network state, and dynamically pushes BGP policy changes to steer traffic across a simulated trading firm network."
authors: ["Mo Shirmohammadi"]
license: "MIT"
homepage: "https://github.com/mo-shirmohammadi/tradenet-fabric"
bug-reports: "https://github.com/mo-shirmohammadi/tradenet-fabric/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.0"}
  "lwt"
  "lwt_ppx"
  "cohttp"
  "cohttp-lwt-unix"
  "yojson"
  "ocamlgraph"
  "dream"
  "qcheck"
  "ppx_deriving"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mo-shirmohammadi/tradenet-fabric.git"
