{# Juniper Junos — OSPF Configuration Template
   =============================================
   Junos OSPF config is hierarchical — very different from Cisco/Arista
   but logically the same protocol underneath.

   Notice:
   - All OSPF config lives under "protocols { ospf { ... } }"
   - Areas contain interface references (not the other way around)
   - BFD is configured per-interface under the OSPF stanza
   - Reference bandwidth is set globally for the process
#}
protocols {
    ospf {
        reference-bandwidth {{ ospf.reference_bandwidth }}m;
        area {{ ospf_area }} {
            interface lo0.0 {
                passive;
                {# Loopback is passive — no OSPF hellos sent on it,
                   but the address is still advertised into OSPF. #}
            }
{% if ospf_interfaces is defined %}
{% for intf in ospf_interfaces %}
            interface {{ intf.name }} {
                hello-interval {{ ospf.hello_interval }};
                dead-interval {{ ospf.dead_interval }};
{% if intf.cost is defined %}
                metric {{ intf.cost }};
{% endif %}
{% if ospf.bfd_enabled %}
                bfd-liveness-detection {
                    minimum-interval 100;
                    multiplier 3;
                    {# Same BFD parameters as Cisco/Arista:
                       100ms interval, 3x multiplier = 300ms detection.
                       The parameters are identical across vendors —
                       only the syntax differs. This is exactly the kind
                       of thing that makes multi-vendor automation harder
                       but also more realistic. #}
                }
{% endif %}
            }
{% endfor %}
{% endif %}
        }
    }
}
