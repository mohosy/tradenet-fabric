{# Cisco IOS — Base Configuration Template
   =========================================
   This template generates the foundational config for Cisco devices.
   It covers: hostname, management, NTP, DNS, syslog, SNMP, banners, AAA.

   WHY TEMPLATES (for interview):
   Every device config is generated from this template + inventory variables.
   No one ever hand-types a config. This means:
   1. Configs are consistent — every device gets the same standards
   2. Changes are auditable — edit the template, see the diff in git
   3. Errors are caught early — CI validates templates before deployment
   4. New devices get the right config automatically

   Jane Street automates as much as they can — this embodies that philosophy.
#}
!
! {{ inventory_hostname }} — Generated by TradeNet Fabric Automation
! Site: {{ site_name }} | Role: {{ role }}
! Generated: {{ ansible_date_time.iso8601 | default('N/A') }}
! DO NOT EDIT MANUALLY — changes will be overwritten by automation
!
hostname {{ inventory_hostname }}
!
! === AAA (Authentication, Authorization, Accounting) ===
aaa new-model
aaa authentication login default local
aaa authorization exec default local
!
! === Local User ===
username admin privilege 15 secret {{ vault_device_password }}
!
! === Management Interface ===
interface Loopback0
 description MGMT-LOOPBACK
 ip address {{ loopback_ip | ipaddr('address') }} {{ loopback_ip | ipaddr('netmask') }}
 no shutdown
!
! === DNS ===
{% for dns in dns_servers %}
ip name-server {{ dns }}
{% endfor %}
ip domain-name tradenet.local
!
! === NTP ===
{% for ntp in ntp_servers %}
ntp server {{ ntp }}
{% endfor %}
clock timezone UTC 0
!
! === Syslog ===
logging host {{ syslog.server }}
logging facility {{ syslog.facility }}
logging trap {{ syslog.severity }}
logging source-interface Loopback0
service timestamps log datetime msec localtime show-timezone
!
! === SNMP ===
snmp-server community {{ snmp.community }} RO
snmp-server location {{ snmp.location }}
snmp-server contact {{ snmp.contact }}
snmp-server source-interface traps Loopback0
!
! === Banner ===
banner motd ^
{{ banner }}^
!
! === SSH ===
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
crypto key generate rsa modulus 2048
!
! === Management ACL ===
ip access-list standard {{ management_acl.name }}
{% for network in management_acl.networks %}
 permit {{ network | ipaddr('network') }} {{ network | ipaddr('wildcard') }}
{% endfor %}
 deny any log
!
line vty 0 15
 access-class {{ management_acl.name }} in
 transport input ssh
 login authentication default
!
! === Console ===
line console 0
 logging synchronous
 login authentication default
!
! === Services ===
no ip http server
no ip http secure-server
service password-encryption
no service pad
no ip source-route
no ip finger
!
end
